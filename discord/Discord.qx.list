HOST-SUFFIX,discord.media,Proxy
HOST-SUFFIX,discordcdn.com,Proxy
HOST-SUFFIX,discord.dev,Proxy
HOST-SUFFIX,discord.gift,Proxy
HOST-SUFFIX,discord.gifts,Proxy
HOST-SUFFIX,discordstatus.com,Proxy
HOST-SUFFIX,discord-activities.com,Proxy
HOST-SUFFIX,discordactivities.com,Proxy
HOST-SUFFIX,discordsays.com,Proxy
HOST-SUFFIX,discordsez.com,Proxy
HOST-KEYWORD,discord,Proxy
